<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StrideGraphicsApi>Direct3D11</StrideGraphicsApi>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Stride.CommunityToolkit.Skyboxes" Version="1.0.0-preview.69" />
    <PackageReference Include="Stride.CommunityToolkit.Bepu" Version="1.0.0-preview.69" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\mmEngine\mmEngine.csproj" />
    <ProjectReference Include="..\mmEcs\mmEcs.csproj" />
  </ItemGroup>

  <!-- Each game is its own folder now, so the default glob only sees
       this project's sources — no Compile Removes needed (the sibling
       projects are never picked up from here). -->

  <ItemGroup>
    <None Include="Assets\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Assets\*.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Assets\*.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Assets\*.obj">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
